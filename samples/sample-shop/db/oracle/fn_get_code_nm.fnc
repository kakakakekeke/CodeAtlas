CREATE OR REPLACE FUNCTION FN_GET_CODE_NM (
    P_GROUP_CD  IN VARCHAR2,
    P_CODE      IN VARCHAR2
) RETURN VARCHAR2
IS
    -- 공통 코드명 조회 함수. 스키마를 붙여서 테이블을 참조한다.
    V_CODE_NM  SHOP.TB_CODE.CODE_NM%TYPE;
BEGIN
    SELECT C.CODE_NM
      INTO V_CODE_NM
      FROM SHOP.TB_CODE C
     WHERE C.GROUP_CD = P_GROUP_CD
       AND C.CODE = P_CODE
       AND C.USE_YN = 'Y';

    RETURN V_CODE_NM;
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RETURN NULL;
    WHEN TOO_MANY_ROWS THEN
        RETURN NULL;
END FN_GET_CODE_NM;
/
