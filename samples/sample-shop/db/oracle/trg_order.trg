-- 주문 상태가 바뀌면 이력을 남기는 트리거
CREATE OR REPLACE TRIGGER TRG_ORDER_STATUS_HIST
    AFTER UPDATE OF ORDER_STATUS ON TB_ORDER
    FOR EACH ROW
    WHEN (OLD.ORDER_STATUS <> NEW.ORDER_STATUS)
BEGIN
    INSERT INTO TB_ORDER_HIST (HIST_ID, ORDER_ID, ORDER_STATUS, CHG_DT, CHG_ID)
    VALUES (SEQ_ORDER_HIST_ID.NEXTVAL, :NEW.ORDER_ID, :NEW.ORDER_STATUS, SYSDATE, NVL(:NEW.UPD_ID, 'SYSTEM'));
END TRG_ORDER_STATUS_HIST;
/

-- 주문 상세 입력 전에 재고를 확인하는 트리거
CREATE OR REPLACE TRIGGER TRG_ORDER_ITEM_STOCK_CHK
    BEFORE INSERT ON TB_ORDER_ITEM
    FOR EACH ROW
DECLARE
    V_STOCK_QTY  NUMBER;
BEGIN
    SELECT NVL(SUM(S.STOCK_QTY), 0)
      INTO V_STOCK_QTY
      FROM TB_STOCK S
     WHERE S.PRODUCT_ID = :NEW.PRODUCT_ID;

    IF V_STOCK_QTY < :NEW.QTY THEN
        RAISE_APPLICATION_ERROR(-20010, '재고가 부족합니다. PRODUCT_ID=' || :NEW.PRODUCT_ID);
    END IF;
END;
/
