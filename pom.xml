<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.codeatlas</groupId>
  <artifactId>codeatlas-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>CodeAtlas</name>
  <description>Spring, MyBatis, SQL, 화면 스크립트를 하나의 그래프로 분석하는 정적 분석 도구</description>

  <modules>
    <module>codeatlas-core</module>
    <module>codeatlas-java</module>
    <module>codeatlas-springxml</module>
    <module>codeatlas-sql</module>
    <module>codeatlas-mybatis</module>
    <module>codeatlas-web</module>
    <module>codeatlas-jsp</module>
    <module>codeatlas-link</module>
    <module>codeatlas-export</module>
    <module>codeatlas-viewer</module>
    <module>codeatlas-cli</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- 라이브러리 버전. 2026-10-11에 Maven Central에서 확인한 최신 안정판. -->
    <jackson.version>2.22.3</jackson.version>
    <junit.version>5.14.4</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <jdt.version>3.47.0</jdt.version>

    <!-- 플러그인 버전 -->
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
  </properties>

  <!-- 모듈이 새 외부 라이브러리를 쓸 때는 자기 pom에 버전을 직접 적어도 된다. 여기에는 여러 모듈이 함께 쓰는 것만 둔다. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.codeatlas</groupId>
        <artifactId>codeatlas-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.codeatlas</groupId>
        <artifactId>codeatlas-java</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.codeatlas</groupId>
        <artifactId>codeatlas-springxml</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.codeatlas</groupId>
        <artifactId>codeatlas-sql</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.codeatlas</groupId>
        <artifactId>codeatlas-mybatis</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.codeatlas</groupId>
        <artifactId>codeatlas-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.codeatlas</groupId>
        <artifactId>codeatlas-jsp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.codeatlas</groupId>
        <artifactId>codeatlas-link</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.codeatlas</groupId>
        <artifactId>codeatlas-export</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.codeatlas</groupId>
        <artifactId>codeatlas-viewer</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jdt</groupId>
        <artifactId>org.eclipse.jdt.core</artifactId>
        <version>${jdt.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <encoding>${project.build.sourceEncoding}</encoding>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <trimStackTrace>true</trimStackTrace>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
          <configuration>
            <!-- 아직 소스가 없는 모듈도 빈 jar로 설치되게 한다. -->
            <skipIfEmpty>false</skipIfEmpty>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven-shade-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
