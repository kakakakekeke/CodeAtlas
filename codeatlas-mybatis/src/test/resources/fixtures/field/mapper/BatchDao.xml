<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 배치 DAO 매퍼: 문자열 ID로 부르는 구식 DAO용 -->
<mapper namespace="fieldBatchDao">

    <!-- 프로시저 호출 -->
    <update id="callArchive" parameterType="map" statementType="CALLABLE">
        {call PKG_BOARD.ARCHIVE_OLD(
            #{baseDt,   mode=IN,  jdbcType=VARCHAR},
            #{resultCd, mode=OUT, jdbcType=VARCHAR}
        )}
    </update>

    <!-- 월별 테이블: 테이블 이름과 정렬 컬럼이 동적 -->
    <select id="selectFromDynamicTable" parameterType="map" resultType="java.util.HashMap">
        SELECT T.*
          FROM ${tableName} T
         WHERE T.BASE_DT = #{baseDt}
           AND T.SEQ &gt; #{lastSeq}
         ORDER BY ${orderByClause}
    </select>

    <delete id="deleteOldBoards" parameterType="list">
        DELETE FROM TB_BOARD
        <where>
            BOARD_ID IN
            <foreach collection="list" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            <include refid="field.common.notDeleted"/>
        </where>
    </delete>

</mapper>
